ody {
    margin:0;
    font-family: Arial, Helvetica, sans-serif;
    color:#333
}

html {
    scroll-behavior: smooth;
}

header{
    background: #C0392B;
    color:aliceblue;
    padding: 15px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav a {
    color: lightgray;
    text-decoration: none;
    margin-left: 20px;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

.hero{
    background:darkgoldenrod;
    color:white;
    text-align: center;
    padding:100px 20px;
}
.hero h2{
    font-size:3rem;
    margin: 0 0 10px;
}
.hero p{
    font-size: 1.2 rem;
    margin-bottom:25px;
}

.btn{
    background:darkslategrey;
    color:white;
    padding:11px 25px;
    border-radius:25px;
    text-decoration:none;
    font-weight:bold;
}

main{
    padding:60px 30px;
    background: #fafafa;
}
.section-title { text-align: center; margin-bottom: 30px; }
.menu-grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(220px 1fr));
    gap:20px;
    max-width:1000px;
    margin:0 auto;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    text-align: center;
}
.price { color: #c0392b; font-weight: bold; font-size: 1.2rem; }


.info { padding: 60px 30px; text-align: center; }
footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 20px
}